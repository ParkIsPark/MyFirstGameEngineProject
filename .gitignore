# -------------------------------------------------------
# Visual Studio
# -------------------------------------------------------
.vs/
*.user
*.suo
*.aps
*.ncb
*.sdf
*.opensdf
*.opendb
ipch/

# -------------------------------------------------------
# Build output (DLLs in bin/ ARE tracked; exes are not)
# -------------------------------------------------------
bin/*.exe
bin/*.pdb
bin/*.ilk
bin/*.lib
bin/*.idb
bin/*.exp

# Intermediate / object files
x64/
Win32/
Debug/
Release/

# -------------------------------------------------------
# Machine-specific engine config (Config/Engine.ini.template IS tracked)
# -------------------------------------------------------
Config/Engine.ini
Config/EditorSettings.ini

# Standalone test executables compiled ad-hoc with g++
*_test.exe

# -------------------------------------------------------
# Runtime / build-area content (not engine source)
# -------------------------------------------------------
bin/Content/
bin/Config/
bin/*.fbx
bin/*.obj
bin/*.world
Content/__pie.world
Config/GameSettings.ini
